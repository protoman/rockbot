ssgattack.b:    db 14        ; initial volume  (beginning of attack) (max 15)
ssgdecay1.b:    db $4D       ; low nibble is sustain  (should be same or lower than ssgparam)
                             ; high nibble is speed  (psgticks per step of decay1)
ssgdecay2.b:    db $30       ; 0 is fastest decay2, 255 is slowest  (psgticks per step of decay2)
ssgparam.b:     db 15        ; this is now the max volume  (end of attack) (max 15)
