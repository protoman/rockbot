        db 1,0,"lgm13.isc",0         ; 115. Steel Drums
        db 127,0,0                   ; 116. Woodblock
        db 1,0,"lgm117.isc",0        ; 117. Taiko Drum
        db 1,0,"lgp43.isc",0         ; 118. Melodic Tom
        db 127,0,0                   ; 119. Synth Drum
        db 127,0,0                   ; 120. Reverse Cymbal
        db 127,0,0                   ; 121. Guitar Fret Noise
        db 127,0,0                   ; 122. Breath Noise
        db 127,0,0                   ; 123. Seashore
