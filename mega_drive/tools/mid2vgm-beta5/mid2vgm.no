        db 1,0,"lgm49.isc",0         ; 49. String Ensemble 1
        db 1,0,"lgm49.isc",0         ; 50. String Ensemble 2
        db 1,0,"lgm51.isc",0         ; 51. SynthStrings 1
        db 1,0,"lgm51.isc",0         ; 52. SynthStrings 2
