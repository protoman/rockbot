        db 1,0,"lgm108.isc",0        ; 106. Banjo
        db 1,0,"lgm108.isc",0        ; 107. Shamisen
        db 1,0,"lgm108.isc",0        ; 108. Koto
        db 1,0,"lgm109.isc",0        ; 109. Kalimba
        db 1,0,"lgm22.isc",0         ; 110. Bag pipe
        db 1,0,"lgm51.isc",0         ; 111. Fiddle
        db 1,0,"lgm108.isc",0        ; 112. Shanai
