        db 1,0,"lgm63.isc",0         ; 63. SynthBrass 1
        db 1,0,"lgm63.isc",0         ; 64. SynthBrass 2
        db 1,0,"lgm67.isc",0         ; 65. Soprano Sax
        db 1,0,"lgm67.isc",0         ; 66. Alto Sax
        db 1,0,"lgm67.isc",0         ; 67. Tenor Sax
        db 1,0,"lgm67.isc",0         ; 68. Baritone Sax
        db 1,0,"lgm72.isc",0         ; 69. Oboe
        db 1,0,"lgm72.isc",0         ; 70. English Horn
        db 1,0,"lgm72.isc",0         ; 71. Bassoon
