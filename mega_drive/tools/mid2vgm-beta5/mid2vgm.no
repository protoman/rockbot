        db 1,0,"lgm74.isc",0         ; 79. Whistle
        db 1,0,"lgm74.isc",0         ; 80. Ocarina
        db 1,0,"lgm81.isc",0         ; 81. Lead 1 (square)
        db 1,0,"lgm82.isc",0         ; 82. Lead 2 (sawtooth)
        db 1,0,"lgm81.isc",0         ; 83. Lead 3 (calliope)  (sounds flute/recorder like)
        db 1,0,"lgm82.isc",0         ; 84. Lead 4 (chiff)     (sounds brass-like?)
        db 1,0,"lgm82.isc",0         ; 85. Lead 5 (charang)   (sounds brass-like?)
        db 1,0,"lgm81.isc",0         ; 86. Lead 6 (voice)
        db 1,0,"lgm87.isc",0         ; 87. Lead 7 (fifths)
        db 1,0,"lgm88.isc",0         ; 88. Lead 8 (bass + lead)
        db 1,0,"lgm06.isc",0         ; 89. Pad 1 (new age)
        db 1,0,"lgm61.isc",0         ; 90. Pad 2 (warm)
        db 1,0,"lgm05.isc",0         ; 91. Pad 3 (polysynth)
        db 1,0,"lgm53.isc",0         ; 92. Pad 4 (choir)
        db 1,0,"lgm51.isc",0         ; 93. Pad 5 (bowed)
        db 1,0,"lgm51.isc",0         ; 94. Pad 6 (metallic)
        db 1,0,"lgm53.isc",0         ; 95. Pad 7 (halo)
        db 1,0,"lgm51.isc",0         ; 96. Pad 8 (sweep)
        db 1,0,"lgm97.isc",0         ; 97. FX 1 (rain)
        db 127,0,0                   ; 98. FX 2 (soundtrack)
        db 1,0,"lgm99.isc",0         ; 99. FX 3 (crystal)
